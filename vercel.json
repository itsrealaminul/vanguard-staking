{
  "version": 2,
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/(.*)", "destination": "/api/index?path=$1" },
    { "source": "/((?!api/)(?!.*\.(png|svg|jpg|jpeg|gif|webp|ico|css|js|woff|woff2|ttf|eot)$).*)", "destination": "/index.html" }
  ]
}
